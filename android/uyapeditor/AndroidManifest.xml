<?xml version="1.0" encoding="utf-8"?>
<!-- UYAP Editör (ayrı uygulama, paket: com.agy.uyapeditor). Kaynak kod CanEditor ile ortaktır; derleme
     scripts/uyapeditor_apk.py ile paket adı com.agy.uyapeditor olarak yeniden adlandırılır (sınıflar com.agy.uyapacici). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.agy.uyapacici"
    android:versionCode="VERSIONCODE"
    android:versionName="VERSIONNAME">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />
    <!-- 28: Java 14 / glibc programları uygulama klasöründen çalıştırılabilsin (29+ hedefte W^X kuralı engeller) -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="UYAP Editör"
        android:icon="@drawable/ic_uyapeditor"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:requestLegacyExternalStorage="true"
        android:largeHeap="true">

        <!-- 📄 UYAP Editör (orijinal, Java 14): Termux / X11 / Termux:API olmadan, dokunmatik.
             .udf / .usf her yerden (dosya yöneticisi, WhatsApp, Celse, tarayıcı, e-posta) doğrudan bu ekranda açılır ve
             "Her zaman" seçilerek varsayılan yapılabilir. -->
        <activity
            android:name=".UyapMobilActivity"
            android:label="UYAP Editör"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|keyboard|navigation|uiMode|density"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- uzantıya göre (file:// ve content://) -->
            <intent-filter android:label="UYAP Editör">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.udf" />
                <data android:pathPattern=".*\\..*\\.udf" />
                <data android:pathPattern=".*\\..*\\..*\\.udf" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.udf" />
                <data android:pathSuffix=".udf" />
                <data android:pathPattern=".*\\.UDF" />
                <data android:pathPattern=".*\\..*\\.UDF" />
                <data android:pathPattern=".*\\..*\\..*\\.UDF" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.UDF" />
                <data android:pathSuffix=".UDF" />
                <data android:pathPattern=".*\\.usf" />
                <data android:pathPattern=".*\\..*\\.usf" />
                <data android:pathPattern=".*\\..*\\..*\\.usf" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.usf" />
                <data android:pathSuffix=".usf" />
                <data android:pathPattern=".*\\.USF" />
                <data android:pathPattern=".*\\..*\\.USF" />
                <data android:pathPattern=".*\\..*\\..*\\.USF" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.USF" />
                <data android:pathSuffix=".USF" />
            </intent-filter>
            <!-- uzantı + herhangi bir MIME (bazı dosya yöneticileri MIME bildirir) -->
            <intent-filter android:label="UYAP Editör">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.udf" />
                <data android:pathPattern=".*\\..*\\.udf" />
                <data android:pathPattern=".*\\..*\\..*\\.udf" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.udf" />
                <data android:pathSuffix=".udf" />
                <data android:pathPattern=".*\\.UDF" />
                <data android:pathPattern=".*\\..*\\.UDF" />
                <data android:pathPattern=".*\\..*\\..*\\.UDF" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.UDF" />
                <data android:pathSuffix=".UDF" />
                <data android:pathPattern=".*\\.usf" />
                <data android:pathPattern=".*\\..*\\.usf" />
                <data android:pathPattern=".*\\..*\\..*\\.usf" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.usf" />
                <data android:pathSuffix=".usf" />
                <data android:pathPattern=".*\\.USF" />
                <data android:pathPattern=".*\\..*\\.USF" />
                <data android:pathPattern=".*\\..*\\..*\\.USF" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.USF" />
                <data android:pathSuffix=".USF" />
            </intent-filter>
            <!-- UDF/USF için kullanılan MIME türleri (WhatsApp, Celse, e-posta ve tarayıcı indirmeleri uzantısız content:// verir) -->
            <intent-filter android:label="UYAP Editör">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/udf" />
                <data android:mimeType="application/x-udf" />
                <data android:mimeType="application/vnd.uyap.udf" />
                <data android:mimeType="application/usf" />
                <data android:mimeType="application/x-usf" />
            </intent-filter>
            <!-- Paylaş menüsü -->
            <intent-filter android:label="UYAP Editör">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".UyapMobilServisi"
            android:exported="false" />

        <!-- Mobil görünüm: belge UdeMobile'ın telefon ekranına göre satır kıran editöründe (assets/editor) açılır -->
        <activity
            android:name=".EditorActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|keyboard"
            android:exported="false" />
        <activity
            android:name=".AdaletActivity"
            android:label="Adalet E-İmza"
            android:exported="false" />
        <activity
            android:name=".PinEkrani"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog"
            android:excludeFromRecents="true"
            android:taskAffinity="com.agy.uyapeditor.pin"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateVisible"
            android:exported="false" />
        <service
            android:name=".AdaletServisi"
            android:exported="false" />
    </application>
</manifest>
