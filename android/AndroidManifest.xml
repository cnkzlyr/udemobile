<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.agy.uyapacici"
    android:versionCode="69"
    android:versionName="3.25.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="28" />
    <!-- 28: gömülü Java (Adalet E-İmza) uygulama klasöründen çalıştırılabilsin (Android 10+ W^X kuralı 29+ hedefte
         uygulama klasöründeki programları engeller; Termux da 28 hedefler). Uygulama dışarıdan kurulur (Play yok). -->

    <!-- USB Host Desteği (OTG E-İmza Akıllı Kart Okuyucular & Tokenlar) -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Termux ve Depolama İzinleri -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Adalet E-İmza servisi (ön plan) ve PIN penceresi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="com.termux" />
        <package android:name="com.termux.x11" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <!-- Dosya Paylaşım Sağlayıcısı (WhatsApp, Word, Gmail, Telegram) -->
        <provider
            android:name=".CanFileProvider"
            android:authorities="com.agy.uyapacici.fileprovider"
            android:exported="true"
            android:grantUriPermissions="true">
            <grant-uri-permission android:pathPrefix="/" />
        </provider>

        <!-- Ana Karşılama ve Dosya Köprüsü -->
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">
            
            <!-- 1. Ana Başlatıcı Simgesi -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 2. UDF Dosyaları - Uzantıya Göre -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:pathPattern=".*\\.udf" />
                <data android:pathPattern=".*\\..*\\.udf" />
                <data android:pathPattern=".*\\..*\\..*\\.udf" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.udf" />
                <data android:pathPattern=".*\\.UDF" />
                <data android:pathPattern=".*\\..*\\.UDF" />
                <data android:pathSuffix=".udf" />
                <data android:pathSuffix=".UDF" />
            </intent-filter>

            <!-- 3. DOCX (Word) Dosyaları - Uzantıya Göre -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\..*\\.docx" />
                <data android:pathPattern=".*\\..*\\..*\\.docx" />
                <data android:pathPattern=".*\\.DOCX" />
                <data android:pathSuffix=".docx" />
                <data android:pathSuffix=".DOCX" />
            </intent-filter>

            <!-- 4. Genel Dosya/Content (MIME TYPE: */* ve UDF/DOCX) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.udf" />
                <data android:pathPattern=".*\\..*\\.udf" />
                <data android:pathPattern=".*\\.UDF" />
                <data android:pathSuffix=".udf" />
                <data android:pathSuffix=".UDF" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathSuffix=".docx" />
            </intent-filter>

            <!-- 5. Binary Stream (application/octet-stream ile UDF) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.udf" />
                <data android:pathPattern=".*\\..*\\.udf" />
                <data android:pathPattern=".*\\.UDF" />
                <data android:pathSuffix=".udf" />
                <data android:pathSuffix=".UDF" />
            </intent-filter>

            <!-- 6. Word MIME Tipleri -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/msword" />
            </intent-filter>

            <!-- 7. PDF Belgeleri -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:pathSuffix=".pdf" />
                <data android:pathSuffix=".PDF" />
            </intent-filter>

            <!-- 8. TIFF / TIF Görüntüleri -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/tiff" />
                <data android:mimeType="image/tif" />
                <data android:pathSuffix=".tiff" />
                <data android:pathSuffix=".tif" />
                <data android:pathSuffix=".TIFF" />
                <data android:pathSuffix=".TIF" />
            </intent-filter>

            <!-- 9. OpenDocument Metin (ODT) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:pathSuffix=".odt" />
                <data android:pathSuffix=".ODT" />
            </intent-filter>

            <!-- 10. Samsung Files "Birlikte Aç" & Fallback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-udf" />
                <data android:mimeType="application/udf" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>

            <!-- 8. Paylaşım Üzerinden Gelen Belgeler -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

        </activity>

        <!-- Google Dokümanlar Stili Mobil UYAP Editör Ekranı -->
        <activity
            android:name=".EditorActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|keyboard"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- v3.16: USB_DEVICE_ATTACHED filtresi KALDIRILDI. Her e-imza takılışında Android editörün
                 yeni bir kopyasını açıyor ve uygulama donuyordu. Kart artık açık editör içinden
                 dinamik alıcı + UsbManager.requestPermission ile algılanır. -->
        </activity>

        <!-- 🏛️ Adalet E-İmza (Termux'suz): yönetim ekranı, ön plan servisi, PIN penceresi -->
        <activity
            android:name=".AdaletActivity"
            android:label="Adalet E-İmza"
            android:exported="false" />
        <activity
            android:name=".PinEkrani"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog"
            android:excludeFromRecents="true"
            android:taskAffinity="com.agy.uyapacici.pin"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateVisible"
            android:exported="false" />
        <service
            android:name=".AdaletServisi"
            android:exported="false" />

    </application>
</manifest>
