<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5"
    android:fitsSystemWindows="true">

    <!-- Üst Eylem Çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1565C0"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <!-- Belge Başlığı -->
        <EditText
            android:id="@+id/etDocTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Yeni_Dilekce.udf"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@null"
            android:singleLine="true"
            android:ellipsize="middle"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <!-- DOCX Olarak Kaydet -->
        <Button
            android:id="@+id/btnSaveDocx"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="W Word"
            android:textColor="#185ABD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/button_word"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginEnd="4dp" />

        <!-- PDF Dışa Aktar -->
        <Button
            android:id="@+id/btnExportPdf"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📄 PDF"
            android:textColor="#C62828"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/button_pdf"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginEnd="4dp" />

        <!-- Paylaş Butonu -->
        <Button
            android:id="@+id/btnShare"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📤 Paylaş ▼"
            android:textColor="#283593"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/button_share"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginEnd="4dp" />

        <!-- UDF Kaydet Butonu -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="💾 UDF"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/button_udf"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp" />

        <!-- Masaüstü UYAP Butonu -->
        <Button
            android:id="@+id/btnDesktopUyap"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="🖥️"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

    </LinearLayout>

    <!-- A4 / Mobil Görünüm WebView -->
    <WebView
        android:id="@+id/editorWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Alt Durum Çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvWordCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 kelime • 0 karakter"
            android:textColor="#5F6368"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSaveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Hazır"
            android:textColor="#2E7D32"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
