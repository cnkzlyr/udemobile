<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:descendantFocusability="afterDescendants"
    android:fitsSystemWindows="false">

    <!-- Üst Eylem Çubuğu (Web Başlığı e-UDF Standardında Tam Ekran Gösterilecektir) -->
    <LinearLayout
        android:id="@+id/editorTopBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1565C0"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        android:elevation="4dp">

        <!-- Geri Butonu -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri Dön" />

        <!-- 1-Tık Hızlı Kaydet Butonu (Canlı Yeşil, Öne Çıkan Floppy Disk) -->
        <Button
            android:id="@+id/btnQuickSave"
            android:layout_width="wrap_content"
            android:minWidth="44dp"
            android:layout_height="36dp"
            android:text="💾 Kaydet"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/button_udf"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Açık Olan Belgeyi Doğrudan Kaydet (1-Tık)" />

        <!-- Belge Başlığı (Esnek Genişlik, Tek Satır, Kırpılabilir) -->
        <EditText
            android:id="@+id/etDocTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Yeni_Dilekce.udf"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@null"
            android:singleLine="true"
            android:ellipsize="middle"
            android:focusableInTouchMode="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:contentDescription="Belge Başlığı" />

        <!-- Görünüm Değiştirici (Mobil / Kağıt A4) -->
        <Button
            android:id="@+id/btnToggleView"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="📱"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="Görünüm Değiştir (Mobil / A4 Kağıt)" />

        <!-- Paylaş Butonu -->
        <Button
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="📤"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="Belgeyi Paylaş" />

        <!-- Farklı Kaydet ve Diğer İşlemler Menü Butonu (3 Nokta) -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:contentDescription="Farklı Kaydet ve İşlemler Menüsü" />

        <!-- Uyumluluk için Gizlenen Eski Butonlar -->
        <Button
            android:id="@+id/btnExportPdf"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSaveDocx"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDesktopUyap"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- A4 / Mobil Görünüm WebView (Tam Ekran) -->
    <WebView
        android:id="@+id/editorWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Alt Durum Çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvWordCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 kelime | 0 karakter"
            android:textColor="#555555"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSaveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hazır"
            android:textColor="#2E7D32"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
