{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanEditor",
  "version": "3.4.7",
  "identifier": "com.caneditor.app",
  "build": {
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "npm run build"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CanEditor - Cross-Platform UYAP & Word Editörü",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
